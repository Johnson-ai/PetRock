DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=replace-with-64-or-more-random-characters
SITE_URL=http://localhost:3000
# Optional: enter real business contact details in the admin dashboard after first login

# Public Vercel Blob store; server-only token, never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_WITH_YOUR_TOKEN

# Optional PostgreSQL pool size, clamped to 1–10 (default 5).
DB_POOL_SIZE=5
